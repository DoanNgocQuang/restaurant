# Copy to .env, then supply passwords locally. Never commit the real .env.
# Existing database volumes require their CURRENT credentials here.
DB_NAME=restaurant
DB_USER=restaurant
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Optional overrides; defaults below work for local Docker builds.
REGISTRY_URL=local
REGISTRY_USER=restaurant
REGISTRY_PROJECT=restaurant
IMAGE_TAG=local
JAVA_TOOL_OPTIONS=-Xms128m -XX:MaxRAMPercentage=60.0

# For Java running outside Docker (Compose sets its own container URL).
DB_URL=jdbc:mysql://localhost:3306/restaurant
